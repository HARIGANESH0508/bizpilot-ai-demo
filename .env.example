# Copy to .env and adjust. Never commit real secrets.
DATABASE_URL=sqlite:///./data/bizpilot.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=10
APPROVAL_THRESHOLD=10000
PRICE_TOLERANCE_PCT=1.0
DEFAULT_VAT_RATE=5.0
# Windows default install path for Tesseract (UB-Mannheim build). Leave blank if on PATH.
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OLLAMA_ENABLED=true
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
N8N_WEBHOOK_SECRET=change-this-long-random-secret
DEMO_PASSWORD=BizPilot#2026
PBKDF2_ITERATIONS=310000
